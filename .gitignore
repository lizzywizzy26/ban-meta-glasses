# Wrangler's local dev state (local D1/SQLite emulation, cache) — regenerated on demand, never real production data.
worker/.wrangler/

# Ingestion pipeline outputs (fetched pages, normalized JSON, generated SQL) — regenerated by running the scripts, not source.
scripts/ingest/output/

# Playwright dependency for the optional Sunglass Hut browser fallback script only — see scripts/ingest/package.json.
scripts/ingest/node_modules/
